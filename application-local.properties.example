# Local Developer Configuration - DO NOT COMMIT SENSITIVE SECRETS TO GIT
# Copy this file to application-local.properties in the Alumni_Backend directory:
#   cp application-local.properties.example application-local.properties
# Then enter your Gmail address and 16-character Google App Password below.
#
# How to generate Google App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled.
# 3. Search for "App passwords" in the search bar or under 2-Step Verification.
# 4. Create an App password named "Alumni Backend" or "GLS Connect".
# 5. Copy the 16-character code (spaces can be omitted or included) and paste it below.

spring.mail.username=your_actual_email@gmail.com
spring.mail.password=your_16_digit_app_password
